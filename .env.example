# Local MongoDB started by `npm run db:up` (docker-compose.dev.yml).
# The database name in the path is what both halves of the app connect to:
# src/db/mongo.ts calls client.db() with no argument, and the backend reads the
# same name out of its own DB_URI. Give each worktree its own name to keep their
# data apart, e.g. bitsmegle_myfeature.
DB_URI=mongodb://127.0.0.1:27017/bitsmegle

SECRET_CLIENT_ID=
SECRET_CLIENT_SECRET=
SECRET_GMAIL_USER=
SECRET_GMAIL_PASS=

# Ports. To run a second worktree alongside this one, shift these by 10 and
# shift PORT in server/.env by the same amount — see "Running several worktrees"
# in the README. REDIRECT_URI and PUBLIC_BACKEND_* must match the ports the
# frontend and backend actually listen on.
FRONTEND_PORT=5173
REDIRECT_URI=http://localhost:5173
PUBLIC_BACKEND_URI=http://localhost:3000
PUBLIC_BACKEND_WS_URI=ws://localhost:3000
BACKEND_PORT=3001
