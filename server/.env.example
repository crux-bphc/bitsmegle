# Local MongoDB started by `npm run db:up` in the repo root (docker-compose.dev.yml).
# Keep the database name in this URI identical to the one in the root .env —
# both processes read the same collections.
DB_URI=mongodb://127.0.0.1:27017/bitsmegle

SECRET_CLIENT_ID=
SECRET_CLIENT_SECRET=

# Must match PUBLIC_BACKEND_URI in the root .env. Shift it by 10 per extra
# worktree — see "Running several worktrees" in the README.
PORT=3000

# Shared secret required to call /stats/* (Authorization: Bearer <key> or
# X-API-Key header). Operational/debug endpoints only — no frontend caller.
STATS_API_KEY=
